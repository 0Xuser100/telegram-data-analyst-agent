#langsmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_PROJECT=your-project-name

#openai — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-5.6-luna

#telegram — from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
#comma-separated chat ids allowed to use the bot. REQUIRED: the agent runs
#shell commands on this machine, so an empty list serves nobody.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT=30

# Routine analysis steps -- a script written into output/ and run with the
# pinned interpreter -- proceed without an approval card. Set to false to put
# every write and every command back behind one, for data or a model you trust
# less. See src/analyst/agent/policy.py for what "routine" means, and why the
# narrowed gate is a scope control rather than a security one.
ANALYST_AUTO_APPROVE=true
